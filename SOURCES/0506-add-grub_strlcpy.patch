From 619df9bd71c77c4b3f56ae0969d3f9f876eac879 Mon Sep 17 00:00:00 2001
From: Jason Rodriguez <jrodriguez@ciq.com>
Date: Thu, 26 Feb 2026 10:16:01 -0500
Subject: [PATCH] Add grub_strlcpy function for CVE patch compatibility

Implement BSD-style strlcpy function to support CVE-2024-45781 and
CVE-2024-45782 patches which use grub_strlcpy for bounds-checked
string copying.

This function provides a safe alternative to grub_strcpy by limiting
the copy to a specified buffer size and always null-terminating the
destination string.
---
 grub-core/kern/misc.c | 15 +++++++++++++++
 include/grub/misc.h   |  1 +
 2 files changed, 16 insertions(+)

diff --git a/grub-core/kern/misc.c b/grub-core/kern/misc.c
index 0dc9f8b..fcc7f69 100644
--- a/grub-core/kern/misc.c
+++ b/grub-core/kern/misc.c
@@ -126,6 +126,21 @@ grub_strcpy (char *dest, const char *src)
   return dest;
 }
 
+grub_size_t
+grub_strlcpy (char *dest, const char *src, grub_size_t size)
+{
+  grub_size_t src_len = grub_strlen (src);
+
+  if (size == 0)
+    return src_len;
+
+  grub_size_t copy_len = (src_len >= size) ? size - 1 : src_len;
+  grub_memcpy (dest, src, copy_len);
+  dest[copy_len] = '\0';
+
+  return src_len;
+}
+
 int
 grub_printf (const char *fmt, ...)
 {
diff --git a/include/grub/misc.h b/include/grub/misc.h
index 69da7f4..96d724e 100644
--- a/include/grub/misc.h
+++ b/include/grub/misc.h
@@ -39,6 +39,7 @@
 
 void *EXPORT_FUNC(grub_memmove) (void *dest, const void *src, grub_size_t n);
 char *EXPORT_FUNC(grub_strcpy) (char *dest, const char *src);
+grub_size_t EXPORT_FUNC(grub_strlcpy) (char *dest, const char *src, grub_size_t size);
 
 static inline char *
 grub_strncpy (char *dest, const char *src, int c)
